# ---------------------------------------------------------------------------
# XeedlyAI — environment variables
# Copy to .env.local (git-ignored) and fill in. Add the same set to Vercel.
# ---------------------------------------------------------------------------

# AI
ANTHROPIC_API_KEY=

# Google Calendar booking (existing)
# GOOGLE_CLIENT_EMAIL, GOOGLE_PRIVATE_KEY, GOOGLE_CALENDAR_ID — already set in deploys
# GEMINI_API_KEY=AIzaSyBeHAjxn4CEoGLGTv2wXl25AUSpgMviX1s

# ---------------------------------------------------------------------------
# Stripe (TEST MODE while developing)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — populated by visiting /api/admin/setup-stripe after first deploy
STRIPE_PRICE_GS_MAINTAIN=
STRIPE_PRICE_GS_GET_FOUND=
STRIPE_PRICE_GS_GET_CHOSEN=
STRIPE_PRICE_MAINTENANCE=
STRIPE_PRICE_DOCZ_SETUP=
STRIPE_PRICE_JOBZ_SETUP=
STRIPE_PRICE_PROPERTY_COMBINED=

# ---------------------------------------------------------------------------
# Supabase (payment system schema — run supabase/migrations/payment_system.sql)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
ADMIN_EMAILS=shad@xeedly.com
ADMIN_PIN=            # 6-digit PIN for /admin/login

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# CRON_SECRET=         # Optional — only needed if calling cron from an external service.
#                      # Vercel Cron uses the x-vercel-cron header and bypasses this.

# ---------------------------------------------------------------------------
# Twilio (SMS payment links + admin notifications). Optional — the system
# degrades to email-only if these are missing.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ADMIN_NOTIFY_NUMBER=   # Shad's phone — receives "payment received" pings

# ---------------------------------------------------------------------------
# Resend (email payment links + reminders). Optional — stubs to console.log.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=billing@xeedly.com

# ---------------------------------------------------------------------------
# Invoice System — payment options displayed on PDF invoices
# ---------------------------------------------------------------------------
VENMO_HANDLE=@XeedlyAI
VENMO_QR_URL=                  # Optional — URL to Venmo QR code image for PDF invoices
XEEDLYAI_ADDRESS=
XEEDLYAI_CITY_STATE_ZIP=

# ---------------------------------------------------------------------------
# Site URL (for Checkout return URLs)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://xeedly.com
